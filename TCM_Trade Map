Antelope Horn 羚羊角", "unit": "Not specified 未指定", "total": 1.0, "by_year": {"1958": 1.0}}]}, {"dest": "United Kingdom", "iso": "GBR", "lat": 55.38, "lon": -3.44, "total": 157.4, "products": [{"product": "Musk 麝香", "unit": "taels 两", "total": 157.4, "by_year": {"1955": 64.0, "1962": 6.4, "1963": 87.0}}]}, {"dest": "Vietnam", "iso": "VNM", "lat": 14.06, "lon": 108.28, "total": 414.0, "products": [{"product": "Musk 麝香", "unit": "taels 两", "total": 410.0, "by_year": {"1959": 26.0, "1960": 128.0, "1961": 96.0, "1962": 64.0, "1963": 96.0}}, {"product": "Antelope Horn 羚羊角", "unit": "kg", "total": 4.0, "by_year": {"1959": 2.0, "1960": 2.0}}]}], "yearly": {"1953": {"France": 192.0, "Hong Kong": 10425.0, "Poland": 480.0}, "1954": {"France": 1152.0, "Hong Kong": 17925.0, "Poland": 480.0}, "1955": {"France": 96.0, "Germany": 320.0, "Hong Kong": 13117.0, "Malaysia": 3.0, "North Korea": 643.0, "United Kingdom": 64.0}, "1956": {"France": 1120.0, "Hong Kong": 11588.0, "Malaysia": 2864.0, "North Korea": 320.0, "Thailand": 5285.0}, "1957": {"Hong Kong": 14108.0, "Malaysia": 320.0, "North Korea": 128.0}, "1958": {"Hong Kong": 28767.0, "Malaysia": 51.0, "North Korea": 96.0, "Thailand": 1.0}, "1959": {"Hong Kong": 13674.0, "North Korea": 50.0, "Poland": 800.0, "Russia": 640.0, "Vietnam": 28.0}, "1960": {"Germany": 10.0, "Hong Kong": 6819.0, "North Korea": 96.0, "Poland": 160.0, "Russia": 672.0, "Vietnam": 130.0}, "1961": {"France": 0.6, "Hong Kong": 11035.0, "North Korea": 32.0, "Vietnam": 96.0}, "1962": {"France": 112.0, "Hong Kong": 9079.0, "North Korea": 64.0, "Switzerland": 69.3, "United Kingdom": 6.4, "Vietnam": 64.0}, "1963": {"Cuba": 68.0, "France": 497.0, "Hong Kong": 5150.0, "Japan": 451.0, "North Korea": 160.0, "Switzerland": 64.0, "United Kingdom": 87.0, "Vietnam": 96.0}}, "years": [1953, 1954, 1955, 1956, 1957, 1958, 1959, 1960, 1961, 1962, 1963], "products": ["Musk 麝香", "Tiger Bone 虎骨", "Deer Antler Velvet 鹿茸", "Deer Antler Horn 鹿角", "Deer Tail 鹿尾", "Antelope Horn 羚羊角"]};

const PRODUCT_COLORS = {
  "Musk 麝香": "#e74c3c",
  "Tiger Bone 虎骨": "#e67e22",
  "Deer Antler Velvet 鹿茸": "#2ecc71",
  "Deer Antler Horn 鹿角": "#3498db",
  "Deer Tail 鹿尾": "#9b59b6",
  "Antelope Horn 羚羊角": "#95a5a6",
};

// Init map
const map = L.map('map').setView([35, 85], 3);
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
  maxZoom: 18,
}).addTo(map);

const origin = DATA.origin;
let flowLines = [];
let markers = [];

// Build product select
const prodSelect = document.getElementById('product-select');
DATA.products.forEach(p => {
  const opt = document.createElement('option');
  opt.value = p;
  opt.textContent = p;
  prodSelect.appendChild(opt);
});

// Build year slider
const yearSlider = document.getElementById('year-slider');
const yearLabel = document.getElementById('year-label');
const years = DATA.years;
yearSlider.max = years.length;
yearSlider.value = years.length; // default "all"

function getYearFilter() {
  const idx = parseInt(yearSlider.value);
  if (idx >= years.length) return null; // all
  return years[idx];
}

function getProductFilter() {
  const v = prodSelect.value;
  if (v === 'all') return null;
  return v;
}

function getQuantity(destName, year, product) {
  const dest = DATA.destinations[destName];
  if (!dest) return 0;

  if (year !== null) {
    // specific year
    const yrData = dest.yearly[String(year)] || {};
    if (product !== null) {
      // need per-product-per-year from flow_data
      const fd = DATA.flow_data.find(f => f.dest === destName);
      if (!fd) return 0;
      let total = 0;
      fd.products.forEach(p => {
        if (product === null || p.product === product) {
          total += (p.by_year[String(year)] || 0);
        }
      });
      return total;
    }
    return yrData;
  }

  // all years
  if (product !== null) {
    const fd = DATA.flow_data.find(f => f.dest === destName);
    if (!fd) return 0;
    let total = 0;
    fd.products.forEach(p => {
      if (p.product === product) total += p.total;
    });
    return total;
  }
  return dest.total_qty;
}

function getFlowWidth(qty) {
  // scale: 0 → 0, max (approx 30000) → 8
  return Math.max(0.5, Math.min(8, Math.sqrt(qty) / 20));
}

function getFlowColor(destName, year, product) {
  // if specific product selected, use that product's color
  if (product !== null) return PRODUCT_COLORS[product] || '#95a5a6';

  // Otherwise find the dominant product
  const fd = DATA.flow_data.find(f => f.dest === destName);
  if (!fd || fd.products.length === 0) return '#95a5a6';
  if (fd.products.length === 1) return PRODUCT_COLORS[fd.products[0].product] || '#95a5a6';

  let maxProd = fd.products[0];
  fd.products.forEach(p => {
    let q = year !== null ? (p.by_year[String(year)] || 0) : p.total;
    let maxQ = year !== null ? (maxProd.by_year[String(year)] || 0) : maxProd.total;
    if (q > maxQ) maxProd = p;
  });
  return PRODUCT_COLORS[maxProd.product] || '#95a5a6';
}

function getMarkerRadius(destName, year, product) {
  const qty = getQuantity(destName, year, product);
  return Math.max(4, Math.min(18, Math.sqrt(qty) / 8));
}

function render() {
  const year = getYearFilter();
  const product = getProductFilter();
  const showFlows = document.getElementById('show-flows').checked;
  const showMarkers = document.getElementById('show-markers').checked;

  yearLabel.textContent = year !== null ? String(year) : 'ALL';

  // Clear previous
  flowLines.forEach(l => map.removeLayer(l));
  markers.forEach(m => map.removeLayer(m));
  flowLines = [];
  markers = [];

  const maxQty = Math.max(...Object.values(DATA.flow_data).map(f => {
    let t = 0;
    f.products.forEach(p => {
      t += year !== null ? (p.by_year[String(year)] || 0) : p.total;
    });
    return t;
  }), 1);

  DATA.flow_data.forEach(fd => {
    const qty = getQuantity(fd.dest, year, product);
    if (qty <= 0) return;

    // Flow line (curved)
    if (showFlows) {
      const fromLatLng = [origin.lat, origin.lon];
      const toLatLng = [fd.lat, fd.lon];

      // Create a curved line by adding midpoint offset
      const midLat = (origin.lat + fd.lat) / 2;
      const midLon = (origin.lon + fd.lon) / 2;
      const offset = (fd.lon - origin.lon) * 0.15;
      const curvedMid = [midLat + offset * 0.1, midLon - offset];

      const line = L.polyline([fromLatLng, curvedMid, toLatLng], {
        color: getFlowColor(fd.dest, year, product),
        weight: getFlowWidth(qty),
        opacity: 0.7,
        smoothFactor: 2,
      }).addTo(map);
      line.bindTooltip(`<b>${fd.dest}</b><br>${product || 'All 全部'}: ${qty.toLocaleString()}`, {sticky: true});
      flowLines.push(line);
    }

    // Destination marker
    if (showMarkers) {
      const mk = L.circleMarker([fd.lat, fd.lon], {
        radius: getMarkerRadius(fd.dest, year, product),
        fillColor: getFlowColor(fd.dest, year, product),
        color: '#fff',
        weight: 1.5,
        fillOpacity: 0.85,
      }).addTo(map);

      // Build tooltip with product breakdown
      let tipHtml = `<b>${fd.dest}</b><br>Total 合计: ${qty.toLocaleString()}`;
      fd.products.forEach(p => {
        const pq = year !== null ? (p.by_year[String(year)] || 0) : p.total;
        if (pq > 0) {
          tipHtml += `<br><span style="color:${PRODUCT_COLORS[p.product]||'#aaa'}">●</span> ${p.product}: ${pq.toLocaleString()} ${p.unit}`;
        }
      });
      mk.bindTooltip(tipHtml);
      markers.push(mk);
    }
  });

  // Origin marker (China)
  const originMk = L.circleMarker([origin.lat, origin.lon], {
    radius: 8,
    fillColor: '#e0c36a',
    color: '#fff',
    weight: 2,
    fillOpacity: 1,
  }).addTo(map);
  originMk.bindTooltip('<b>🇨🇳 China 中国 (Origin)</b>');
  markers.push(originMk);
}

// Event listeners
prodSelect.addEventListener('change', render);
yearSlider.addEventListener('input', render);
document.getElementById('show-flows').addEventListener('change', render);
document.getElementById('show-markers').addEventListener('change', render);

// Initial render
render();
</script>
